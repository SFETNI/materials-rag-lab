      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "snapshot_date": {
      "const": "2025-05-01"
    },
    "source_kind": {
      "const": "synthetic_internal"
    },
    "specimen_ids": {
      "items": {
        "pattern": "^B0(?:17|21)-F0[1-8]$",
