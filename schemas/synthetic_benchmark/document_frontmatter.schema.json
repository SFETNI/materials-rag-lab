    "build_id": {
      "enum": [
        "B017",
        "B021"
      ]
    },
    "build_ids": {
      "items": {
        "enum": [
          "B017",
          "B021"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "case_id": {
      "const": "NCR-B017-004"
    },
    "corpus_id": {
      "const": "mrl_internal_in718_v1"
    },
    "corpus_version": {
      "const": "1.0.0"
    },
    "document_id": {
      "enum": [
        "MAT-SPEC-IN718-001",
        "PROC-LPBF-001",
        "BUILD-B017",
        "BUILD-B021",
        "HT-B017",
        "HT-B021",
        "FAT-B017",
        "FAT-B021",
        "FRACT-B017",
        "NCR-B017-004",
        "RCA-B017-004",
        "RCA-B017-004-rev2"
      ],
      "type": "string"
    },
    "document_type": {
      "enum": [
        "material_specification",
        "process_procedure",
        "build_record",
        "heat_treatment_record",
        "fatigue_report",
        "fractography_report",
        "non_conformance_report",
        "root_cause_analysis"
      ]
    },
    "effective_from": {
      "format": "date",
      "type": "string"
    },
    "effective_to": {
      "format": "date",
      "type": [
        "string",
        "null"
      ]
    },
    "is_current": {
      "type": "boolean"
