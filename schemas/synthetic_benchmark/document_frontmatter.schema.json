    "revision_family_id",
    "title",
    "document_type",
    "organization",
    "material",
    "process",
    "study_id",
    "build_ids",
    "revision",
    "status",
    "authority",
    "is_current",
    "issued_on",
    "effective_from",
    "effective_to",
    "snapshot_date",
    "related_documents",
    "language",
    "supersedes",
    "superseded_by"
  ],
  "title": "Frozen synthetic IN718 corpus front matter, v1.0.0",
  "type": "object"
}
