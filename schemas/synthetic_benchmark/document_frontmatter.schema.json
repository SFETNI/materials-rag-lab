            "PROC-LPBF-001",
            "BUILD-B017",
            "BUILD-B021",
            "HT-B017",
            "HT-B021",
            "FAT-B017",
            "FAT-B021",
            "FRACT-B017",
            "NCR-B017-004",
            "RCA-B017-004",
            "RCA-B017-004-rev2"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes": {
      "anyOf": [
        {
          "enum": [
            "MAT-SPEC-IN718-001",
            "PROC-LPBF-001",
            "BUILD-B017",
            "BUILD-B021",
            "HT-B017",
            "HT-B021",
            "FAT-B017",
            "FAT-B021",
            "FRACT-B017",
            "NCR-B017-004",
            "RCA-B017-004",
            "RCA-B017-004-rev2"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "synthetic": {
